{
  "name": "android-mirroring-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server/relay.js",
    "tunnel": "node server/deploy_tunnel.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "setup": "powershell -ExecutionPolicy Bypass -Command \"Invoke-WebRequest -Uri 'https://dl.google.com/android/repository/platform-tools-latest-windows.zip' -OutFile 'server/platform-tools.zip'; Expand-Archive -Path 'server/platform-tools.zip' -DestinationPath 'server/tools' -Force\""
  },
  "dependencies": {
    "@yume-chan/adb": "^2.6.2",
    "@yume-chan/adb-backend-webusb": "^0.0.19",
    "@yume-chan/scrcpy": "^2.3.0",
    "jmuxer": "^2.1.1",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "localtunnel": "^2.0.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
