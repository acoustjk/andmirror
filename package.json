{
  "name": "android-mirroring-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server/relay.js",
    "setup": "powershell -ExecutionPolicy Bypass -Command \"Invoke-WebRequest -Uri 'https://dl.google.com/android/repository/platform-tools-latest-windows.zip' -OutFile 'server/platform-tools.zip'; Expand-Archive -Path 'server/platform-tools.zip' -DestinationPath 'server/tools' -Force\""
  },
  "dependencies": {
    "@yume-chan/adb": "^1.1.1",
    "@yume-chan/adb-backend-webusb": "^1.1.1",
    "@yume-chan/scrcpy": "^1.1.1",
    "jmuxer": "^2.1.0",
    "lucide-react": "^0.479.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
